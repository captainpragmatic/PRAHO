msgstr "Dreptul la rectificare"

#: templates/legal/privacy_policy_content.html:235
msgid "Request correction of inaccurate personal data."
msgstr "Solicitați corectarea datelor personale inexacte."

#: templates/legal/privacy_policy_content.html:238
msgid "Right to Erasure"
