#: templates/legal/terms_of_service_content.html:45
#, python-format
msgid ""
"\n"
"                By accessing or using the PRAHO Platform services provided by %(legal_name)s (\"Company\", \"we\", \"us\", \"our\"),\n"
"                you (\"Customer\", \"you\", \"your\") agree to be bound by these Terms of Service (\"Terms\").\n"
"                "
msgstr ""
"\n"
"                Prin accesarea sau utilizarea serviciilor PRAHO Platform furnizate de %(legal_name)s (\"Companie\", \"noi\", \"ne\", \"noastră\"),\n"
"                dvs. (\"Client\", \"dvs.\", \"al dvs.\") acceptați să fiți obligați de acești Termeni de Serviciu (\"Termeni\").\n"
"                "

#: templates/legal/terms_of_service_content.html:51
#, python-format
msgid ""
"\n"
"                If you do not agree to these Terms, you may not access or use our services. These Terms constitute\n"
"                a legally binding agreement between you and %(legal_name)s.\n"
"                "
msgstr ""
"\n"
"                Dacă nu sunteți de acord cu acești Termeni, nu puteți accesa sau utiliza serviciile noastre. Acești Termeni constituie\n"
"                un acord legal obligatoriu între dvs. și %(legal_name)s.\n"
"                "

#: templates/legal/terms_of_service_content.html:58
msgid ""
"\n"
"                    IMPORTANT: By creating an account or using our services, you confirm that you are at least 18 years old\n"
"                    and have the legal capacity to enter into binding contracts.\n"
"                    "
msgstr ""
"\n"
"                    IMPORTANT: Prin crearea unui cont sau utilizarea serviciilor noastre, confirmați că aveți cel puțin 18 ani\n"
"                    și aveți capacitatea juridică de a încheie contracte obligatorii.\n"
"                    "

#: templates/legal/terms_of_service_content.html:70
#, python-format
msgid ""
"\n"
"                %(legal_name)s provides web hosting and related services through the PRAHO Platform, including but not limited to:\n"
"                "
msgstr ""
"\n"
"                %(legal_name)s oferă servicii de găzduire web și servicii conexe prin PRAHO Platform, inclusiv, dar fără a se limita la:\n"
"                "

#: templates/legal/terms_of_service_content.html:75
msgid "Shared and VPS web hosting"
msgstr "Găzduire web partajată și VPS"

#: templates/legal/terms_of_service_content.html:76
msgid "Domain name registration and management"
msgstr "Înregistrarea și gestionarea numelor de domenii"

#: templates/legal/terms_of_service_content.html:77
