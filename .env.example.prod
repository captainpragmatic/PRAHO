# ============================================================
# PRAHO Production Environment Configuration
# ============================================================
# Copy to .env.prod, fill in values, then deploy:
#   cp .env.example.prod .env.prod
#   # Edit .env.prod with your values
#   make deploy-prod
#
# Legend:
#   [REQUIRED]       — PRAHO won't start without this
#   [RECOMMENDED]    — Core feature disabled without this
#   [OPTIONAL]       — Has a sensible default, override only if needed
#
# Generate secrets:
#   openssl rand -base64 50   (DJANGO_SECRET_KEY, PORTAL_DJANGO_SECRET_KEY)
#   openssl rand -base64 32   (DB_PASSWORD, HMAC_SECRET)
#   python -c 'import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
# ============================================================

# --- Server (used by Ansible, not by Django) -----------------
# [REQUIRED] Server public IP
PRAHO_SERVER_IP=
# [OPTIONAL] SSH user for Ansible
PRAHO_SSH_USER=root
# [OPTIONAL] SSH key path
PRAHO_SSH_KEY=~/.ssh/id_ed25519

# --- Deployment (used by Ansible, not by Django) ---------------
# [REQUIRED] Git tag to deploy (e.g. v0.23.0). Override: make deploy-prod VERSION=v0.23.0
PRAHO_VERSION=
# [OPTIONAL] Docker only: image tag and registry prefix for deploy/scripts/deploy.sh (default: latest,
# local images). rollback.sh overrides the tag for one run.
VERSION=latest
REGISTRY=

# --- Domains -------------------------------------------------
# Two distinct hostnames are required; pass both to both Django services.
# Bare hostnames only (no scheme, path or port). DOMAIN is a legacy Compose fallback.
# [REQUIRED] e.g. portal.pragmatichost.com
PORTAL_DOMAIN=
# [REQUIRED] e.g. platform.pragmatichost.com
PLATFORM_DOMAIN=
# [REQUIRED] Let's Encrypt notification email
ACME_EMAIL=
# Edge HSTS header (Caddy). Leave HSTS_POLICY unset in production: Caddy then sends
# "max-age=31536000; includeSubDomains". To change it, double-quote any value containing ";"
# (e.g. HSTS_POLICY="max-age=31536000; includeSubDomains; preload" after submitting the domain at
# hstspreload.org): `source .env`, Docker Compose and the native Caddy template all strip the quotes.
# [REQUIRED] Include each service's public hostname; native Ansible supplies these.
# Standalone Compose derives per-service ALLOWED_HOSTS from the domains above.
ALLOWED_HOSTS=
# Standalone Compose staff allowlist: space-separated CIDRs, never commas.
# Replace/add staff or VPN CIDRs before deploying; default permits loopback only.
# Ansible uses platform_allowed_ips in inventory, not this environment variable.
PLATFORM_ALLOWED_CIDRS="127.0.0.1/32 ::1/128"

# --- Secrets -------------------------------------------------
# [REQUIRED] openssl rand -base64 50
DJANGO_SECRET_KEY=
# [RECOMMENDED] openssl rand -base64 50 — the portal's own Django key. Required on a separate portal
# host (deploy.sh portal-only; deploy/scripts/portal-env.sh writes that host's file). The single-server
# and container-service portals use it when set, else DJANGO_SECRET_KEY; native deploys ignore it.
PORTAL_DJANGO_SECRET_KEY=
# [REQUIRED] openssl rand -base64 32
DB_PASSWORD=
# [REQUIRED] openssl rand -base64 32 — portal↔platform auth
HMAC_SECRET=
# [REQUIRED] Same value as HMAC_SECRET
PLATFORM_API_SECRET=
# [REQUIRED] python -c "import secrets; print(secrets.token_urlsafe(32))" — platform→portal webhook auth
PLATFORM_TO_PORTAL_WEBHOOK_SECRET=

# --- Database ------------------------------------------------
# [OPTIONAL] PostgreSQL database name
DB_NAME=praho
# [OPTIONAL] PostgreSQL user
DB_USER=praho
# [OPTIONAL] PostgreSQL host. Docker single-server and the platform-only bundled database use
# their own `db` container whatever this says.
DB_HOST=localhost
# [OPTIONAL] PostgreSQL port
DB_PORT=5432
# [OPTIONAL] 'require' for remote DB, 'disable' for localhost. Docker's bundled databases use
# 'disable' whatever this says.
DB_SSLMODE=require

# --- Application ---------------------------------------------
# [OPTIONAL] Set by Ansible based on praho_env
DJANGO_SETTINGS_MODULE=config.settings.prod
# [OPTIONAL] NEVER true in production
DEBUG=false
# [RECOMMENDED] Verified known_hosts file for managed-node SSH
PRAHO_SSH_KNOWN_HOSTS_PATH=
# [OPTIONAL] 0 permits non-expiring tokens (not recommended)
API_TOKEN_DEFAULT_TTL_DAYS=90
# [OPTIONAL] Must be >= 1
API_TOKEN_MAX_TTL_DAYS=365
# [OPTIONAL] Must be >= 1
API_TOKEN_MAX_ACTIVE_PER_USER=20

# --- Inter-Service Communication -----------------------------
# Required: native Caddy example. Docker single-server trusts its own Caddy network whatever this
# says; Docker portal-only needs the CIDR of the proxy in front of it.
PORTAL_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# [OPTIONAL] Native: localhost. Docker single-server uses its platform container whatever this
# says; Docker portal-only needs the platform's public URL, e.g. https://platform.example.com/api
PLATFORM_API_BASE_URL=http://localhost:8700/api
# [OPTIONAL] true for localhost inter-service (behind Caddy)
PLATFORM_API_ALLOW_INSECURE_HTTP=true
# [OPTIONAL] false when behind TLS proxy (Caddy/Nginx); true if Django faces the internet
DJANGO_SECURE_SSL_REDIRECT=false

# --- Static & Media ------------------------------------------
# [OPTIONAL] Set by Ansible
STATIC_ROOT=/opt/praho/static
# [OPTIONAL] Set by Ansible
MEDIA_ROOT=/opt/praho/media

# --- Email ---------------------------------------------------
# [RECOMMENDED] smtp|amazon_ses|sendgrid|mailgun
EMAIL_PROVIDER=smtp
# [RECOMMENDED] SMTP server (e.g. smtp.gmail.com)
EMAIL_HOST=
# [OPTIONAL] SMTP port
EMAIL_PORT=587
# [RECOMMENDED] SMTP username
EMAIL_HOST_USER=
# [RECOMMENDED] SMTP password
EMAIL_HOST_PASSWORD=
# [OPTIONAL] SMTP timeout in seconds
EMAIL_TIMEOUT=30
# [OPTIONAL]
DEFAULT_FROM_EMAIL="PRAHO Platform <noreply@pragmatichost.com>"
# [OPTIONAL] Error notification sender
SERVER_EMAIL=server@pragmatichost.com

# Email: AWS SES (if EMAIL_PROVIDER=amazon_ses)
# AWS_ACCESS_KEY_ID=                    # [RECOMMENDED:ses] AWS credentials
# AWS_SECRET_ACCESS_KEY=                # [RECOMMENDED:ses]
# AWS_SES_REGION=eu-west-1             # [OPTIONAL:ses]
# AWS_SES_CONFIGURATION_SET=           # [OPTIONAL:ses]

# Email: SendGrid (if EMAIL_PROVIDER=sendgrid)
# SENDGRID_API_KEY=                    # [RECOMMENDED:sendgrid]

# Email: Mailgun (if EMAIL_PROVIDER=mailgun)
# MAILGUN_API_KEY=                     # [RECOMMENDED:mailgun]
# MAILGUN_SENDER_DOMAIN=              # [RECOMMENDED:mailgun]
# MAILGUN_API_URL=https://api.eu.mailgun.net/v3  # [OPTIONAL:mailgun] EU region

# Email: Rate Limiting
# [OPTIONAL]
EMAIL_MAX_PER_MINUTE=50
# [OPTIONAL]
EMAIL_MAX_PER_HOUR=1000
# [OPTIONAL]
EMAIL_MAX_PER_DAY=10000
# [OPTIONAL]
EMAIL_BURST_SIZE=100
# [OPTIONAL]
EMAIL_MAX_RETRIES=3
# [OPTIONAL] seconds
EMAIL_RETRY_DELAY=60
# [OPTIONAL] Webhook signature validation
EMAIL_WEBHOOK_SECRET=

# Email: Templates & Deliverability
# [OPTIONAL] seconds
EMAIL_TEMPLATE_CACHE_TIMEOUT=3600
# [OPTIONAL]
EMAIL_TEMPLATE_STRICT_MODE=false
# [OPTIONAL]
EMAIL_SOFT_BOUNCE_THRESHOLD=3

# --- Payments (Stripe) --------------------------------------
# [RECOMMENDED] From Stripe dashboard
STRIPE_PUBLISHABLE_KEY=
# [RECOMMENDED] From Stripe dashboard
STRIPE_SECRET_KEY=
# [RECOMMENDED] From Stripe webhooks
STRIPE_WEBHOOK_SECRET=

# --- Romanian Compliance ------------------------------------
# [RECOMMENDED] https://api.anaf.ro/prod/FCTEL/rest
EFACTURA_API_URL=
# [RECOMMENDED] ANAF OAuth key
EFACTURA_API_KEY=

# Company information (appears on invoices)
# [RECOMMENDED] Legal company name
COMPANY_NAME=
# [RECOMMENDED] Romanian tax ID (e.g. RO12345678)
COMPANY_CUI=
# [RECOMMENDED] Street address
COMPANY_ADDRESS=
# [RECOMMENDED] City
COMPANY_CITY=
# [OPTIONAL]
COMPANY_COUNTRY=România
# [OPTIONAL] Contact email
COMPANY_EMAIL=
# [OPTIONAL] Contact phone
COMPANY_PHONE=
# [OPTIONAL]
COMPANY_WEBSITE=

# --- Encryption ----------------------------------------------
# Production refuses to start without these two keys. Generate each (a different key for each) with:
#   python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# [REQUIRED] AES-256-GCM key — encrypts TOTP secrets for 2FA and sensitive fields
DJANGO_ENCRYPTION_KEY=
# [REQUIRED] AES-256-GCM key — encrypts provider credentials
CREDENTIAL_VAULT_MASTER_KEY=
# [OPTIONAL]
CREDENTIAL_VAULT_ENABLED=true
# [OPTIONAL]
CREDENTIAL_VAULT_DEFAULT_EXPIRY_DAYS=30
# [OPTIONAL]
CREDENTIAL_VAULT_MAX_AGE_DAYS=90

# --- Monitoring & Logging ------------------------------------
# [OPTIONAL] Sentry error tracking DSN
SENTRY_DSN=
# [OPTIONAL] INFO for production
LOG_LEVEL=INFO
# [OPTIONAL] Shown in Sentry releases
APP_VERSION=

# --- SIEM Integration ----------------------------------------
# Uncomment if using Splunk/QRadar/Elastic SIEM
# SIEM_ENABLED=false                   # [OPTIONAL] Enable SIEM log forwarding
# SIEM_FORMAT=json                     # [OPTIONAL] cef|leef|json|syslog
# SIEM_PROTOCOL=tcp                    # [OPTIONAL] tcp|udp|https|file
# SIEM_HOST=localhost                  # [OPTIONAL] SIEM collector host
# SIEM_PORT=514                        # [OPTIONAL] SIEM collector port

# --- Cache ---------------------------------------------------
# PRAHO uses the database cache (ADR-0020). Redis is not supported:
# leave REDIS_URL unset, or the Platform refuses to start.
# [OPTIONAL] Increment to invalidate all caches
CACHE_VERSION=1

# --- Performance Tuning --------------------------------------
# [OPTIONAL] Outbound HTTP pool
HTTP_POOL_CONNECTIONS=10
# [OPTIONAL]
HTTP_POOL_MAXSIZE=20
# [OPTIONAL]
HTTP_MAX_RETRIES=3
# [OPTIONAL] seconds
HTTP_TIMEOUT_CONNECT=10.0
# [OPTIONAL] seconds
HTTP_TIMEOUT_READ=30.0

# --- Backup --------------------------------------------------
# BACKUP_S3_BUCKET=                    # [OPTIONAL] S3 bucket for off-site backups
# BACKUP_ENCRYPTION_KEY=               # [OPTIONAL] Encrypt backups at rest

# --- Localization --------------------------------------------
# [OPTIONAL]
LANGUAGE_CODE=ro-RO
# [OPTIONAL]
TIME_ZONE=Europe/Bucharest
