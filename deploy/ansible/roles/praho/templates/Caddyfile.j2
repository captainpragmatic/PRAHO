# PRAHO Caddy Configuration (Docker) — Two-Domain Architecture
# Generated by Ansible
#
# Portal:   {{ portal_domain }} (public)
# Platform: {{ platform_domain }} (restricted)

# ---------------------------------------------------------------------------
# 1. Portal — public-facing customer service
# ---------------------------------------------------------------------------
{% if deploy_portal %}
{{ portal_domain }} {
    tls {{ acme_email }}

    # HSTS_POLICY sets this per environment (staging: max-age=3600). It is set twice on purpose:
    # the deferred block below replaces the header Django sends, and this immediate line covers
    # responses Caddy generates itself (a 502 when the upstream is down), which skip deferred headers.
    header Strict-Transport-Security "{{ hsts_policy }}"
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "{{ hsts_policy }}"
        -Server
    }

    encode gzip zstd

    handle_path /static/* {
        root * /srv/portal-static
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    handle /status/ {
        reverse_proxy portal:{{ portal_port }}
    }

    handle {
        request_body {
            max_size 5MB
        }
        reverse_proxy portal:{{ portal_port }} {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    log {
        output file /data/portal-access.log {
            roll_size 100mb
            roll_keep 5
        }
    }
}
{% endif %}

# ---------------------------------------------------------------------------
# 2. Platform — staff/admin service (IP-restricted by default)
# ---------------------------------------------------------------------------
{% if deploy_platform %}
{{ platform_domain }} {
    tls {{ acme_email }}

    # HSTS_POLICY sets this per environment (staging: max-age=3600). It is set twice on purpose:
    # the deferred block below replaces the header Django sends, and this immediate line covers
    # responses Caddy generates itself (a 502 when the upstream is down), which skip deferred headers.
    header Strict-Transport-Security "{{ hsts_policy }}"
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "{{ hsts_policy }}"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    encode gzip zstd

    # Public handles cap request bodies at Django's DATA_UPLOAD_MAX_MEMORY_SIZE (10 MiB).
    # None of these routes accepts file uploads, so the cap refuses nothing Django would
    # take, and an oversized body stops here instead of streaming into a worker.
    handle /api/users/health/* {
        request_body {
            max_size 10MiB
        }
        reverse_proxy platform:{{ platform_port }}
    }

    handle /integrations/webhooks/* {
        request_body {
            max_size 10MiB
        }
        reverse_proxy platform:{{ platform_port }}
    }

    # Email provider bounce feeds and the recipient unsubscribe page are public too.
    handle /notifications/webhooks/* {
        request_body {
            max_size 10MiB
        }
        reverse_proxy platform:{{ platform_port }}
    }

    handle /notifications/unsubscribe/* {
        request_body {
            max_size 10MiB
        }
        reverse_proxy platform:{{ platform_port }}
    }

    # Django enforces API authentication, including its explicit public exceptions.
    handle /api/* {
        request_body {
            max_size 10MiB
        }
        reverse_proxy platform:{{ platform_port }}
    }

    # An omitted or empty list keeps the loopback restriction.
    @staff remote_ip {{ platform_allowed_ips | default(['127.0.0.1/32', '::1/128'], true) | join(' ') }}
    handle @staff {
        handle_path /static/* {
            root * /srv/static
            file_server
            header Cache-Control "public, max-age=31536000, immutable"
        }

        handle_path /media/* {
            root * /srv/media
            file_server
            header Cache-Control "public, max-age=86400"
        }

        handle {
            reverse_proxy platform:{{ platform_port }} {
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-For {remote_host}
                header_up X-Forwarded-Proto {scheme}
            }
        }
    }

    respond "Access denied" 403

    log {
        output file /data/platform-access.log {
            roll_size 100mb
            roll_keep 5
        }
    }
}
{% endif %}

# ---------------------------------------------------------------------------
# 3. Bare IP — redirect to portal domain
# ---------------------------------------------------------------------------
http://{{ ansible_default_ipv4.address | default('0.0.0.0') }} {
    redir https://{{ portal_domain }}{uri} permanent
}
