#!/bin/bash
# =============================================================================
# PRAHO Database and Media Backup Script (Native PostgreSQL)
# Generated by Ansible - DO NOT EDIT
# =============================================================================

set -euo pipefail

BACKUP_DIR="{{ backup_directory }}"
RETENTION_DAYS={{ backup_retention_days }}
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
# The process id keeps a manual run started in the same second as the cron run from writing into
# the same file. No two running processes share one.
BACKUP_FILE="${BACKUP_DIR}/praho_backup_${TIMESTAMP}_$$.dump"
# pg_dump creates its output file before it connects, so it writes under another name and the dump
# is renamed once complete: a failed one never matches praho_backup_*.dump, which restore --latest
# picks from.
PARTIAL_FILE="${BACKUP_FILE}.partial"
# MEDIA_ROOT (uploads and generated documents, such as ANAF's e-Factura response archives) is
# archived next to its dump, so a restore finds the pair by name.
MEDIA_ROOT="{{ project_root }}/media"
MEDIA_FILE="${BACKUP_FILE%.dump}.media.tar.gz"
MEDIA_PARTIAL="${MEDIA_FILE}.partial"
trap 'rm -f "${PARTIAL_FILE}" "${MEDIA_PARTIAL}"' EXIT

echo "[$(date)] Starting native PostgreSQL backup..."

mkdir -p "${BACKUP_DIR}"

# A killed backup skips its EXIT trap. A partial untouched for a day (1440 minutes) is abandoned; one
# being written changes as the dump streams in. Before the dump, so a string of interrupted runs
# cannot pile them up either.
find "${BACKUP_DIR}" -name "praho_backup_*.partial" -mmin +1440 -delete

# Direct pg_dump (no Docker)
PGPASSWORD="{{ deployed_env.DB_PASSWORD }}" pg_dump \
    -h localhost \
    -U {{ deployed_env.DB_USER | default('praho') }} \
    -d {{ deployed_env.DB_NAME | default('praho') }} \
    --format=custom \
    --compress=9 \
    -f "${PARTIAL_FILE}"

if [ -s "${PARTIAL_FILE}" ]; then
    mv "${PARTIAL_FILE}" "${BACKUP_FILE}"
    echo "[$(date)] Backup created: ${BACKUP_FILE}"
    echo "[$(date)] Size: $(du -h "${BACKUP_FILE}" | cut -f1)"
else
    echo "[$(date)] ERROR: Backup failed!"
    exit 1
fi

if tar -C "$(dirname "${MEDIA_ROOT}")" -czf "${MEDIA_PARTIAL}" "$(basename "${MEDIA_ROOT}")"; then
    mv "${MEDIA_PARTIAL}" "${MEDIA_FILE}"
    echo "[$(date)] Media archived: ${MEDIA_FILE} ($(du -h "${MEDIA_FILE}" | cut -f1))"
else
    # The database dump is complete and kept; the run still fails, so cron notices.
    echo "[$(date)] ERROR: Media archive failed; the database backup ${BACKUP_FILE} is complete"
    exit 1
fi

# Cleanup old backups, and the media archives that go with them
echo "[$(date)] Cleaning up backups older than ${RETENTION_DAYS} days..."
find "${BACKUP_DIR}" -name "praho_backup_*.dump" -mtime +${RETENTION_DAYS} -delete
find "${BACKUP_DIR}" -name "praho_backup_*.media.tar.gz" -mtime +${RETENTION_DAYS} -delete

echo "[$(date)] Current backups:"
ls -lh "${BACKUP_DIR}"/praho_backup_*.dump 2>/dev/null || echo "No backups found"

echo "[$(date)] Backup completed successfully"
