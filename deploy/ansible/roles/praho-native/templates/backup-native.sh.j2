#!/bin/bash
# =============================================================================
# PRAHO Database and Media Backup Script (Native PostgreSQL)
# Generated by Ansible - DO NOT EDIT
# =============================================================================

set -euo pipefail
export PGPASSFILE="{{ project_root }}/credentials/postgresql.pgpass"
umask 077

BACKUP_DIR="{{ backup_directory }}"
RETENTION_DAYS={{ backup_retention_days }}
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
# The process id keeps a manual run started in the same second as the cron run from writing into
# the same file. No two running processes share one.
BACKUP_FILE="${BACKUP_DIR}/praho_backup_${TIMESTAMP}_$$.dump"
# pg_dump creates its output file before it connects, so it writes under another name and the dump
# is renamed once complete: a failed one never matches praho_backup_*.dump, which restore --latest
# picks from.
PARTIAL_FILE="${BACKUP_FILE}.partial"
# MEDIA_ROOT (uploads and generated documents, such as ANAF's e-Factura response archives) is
# archived next to its dump, so a restore finds the pair by name.
MEDIA_ROOT="{{ project_root }}/media"
MEDIA_FILE="${BACKUP_FILE%.dump}.media.tar.gz"
MEDIA_PARTIAL="${MEDIA_FILE}.partial"
OFFSITE_HANDLED=0
backup_exit() {
    local result=$?
    rm -f "${PARTIAL_FILE}" "${MEDIA_PARTIAL}"
    if [ "$result" -ne 0 ] && [ "$OFFSITE_HANDLED" -eq 0 ]; then
        if ! "{{ project_root }}/.venv-linux/bin/python" "{{ project_root }}/src/services/platform/manage.py" upload_platform_backup --report-failure; then
            echo "ERROR: Backup failure could not be recorded" >&2
        fi
    fi
    return "$result"
}
trap backup_exit EXIT

echo "[$(date)] Starting native PostgreSQL backup..."

# Refuse a linked directory and change only this user's regular backup artifacts.
if [ -L "$BACKUP_DIR" ]; then
    echo "ERROR: Backup directory must not be a symlink" >&2
    exit 1
fi
mkdir -p "$BACKUP_DIR"
if [ ! -O "$BACKUP_DIR" ]; then
    echo "ERROR: Backup directory must belong to the backup user" >&2
    exit 1
fi
chmod 0700 "$BACKUP_DIR"
# The scheduled and manual service paths must not produce overlapping backup pairs.
exec 9>"$BACKUP_DIR/.backup.lock"
if ! flock -n 9; then
    echo "A Platform backup is already running"
    exit 0
fi
find "$BACKUP_DIR" -maxdepth 1 -type f -user "$(id -un)" \
    \( -name 'praho_backup_*.sql.gz' -o -name 'praho_backup_*.dump' \
       -o -name 'praho_backup_*.metadata.json' -o -name 'praho_backup_*.media.tar.gz' \
       -o -name 'praho_backup_*.partial' \) -exec chmod 0600 {} +

# A killed backup skips its EXIT trap. A partial untouched for a day (1440 minutes) is abandoned; one
# being written changes as the dump streams in. Before the dump, so a string of interrupted runs
# cannot pile them up either.
find "${BACKUP_DIR}" -maxdepth 1 -type f -user "$(id -un)" -name "praho_backup_*.partial" -mmin +1440 -delete

# Direct pg_dump (no Docker)
pg_dump \
    -h {{ deployed_env.DB_HOST | default('localhost') | quote }} \
    -p {{ deployed_env.DB_PORT | default('5432') | quote }} \
    -U {{ deployed_env.DB_USER | default('praho') | quote }} \
    -d {{ deployed_env.DB_NAME | default('praho') | quote }} \
    --format=custom \
    --compress=9 \
    -f "${PARTIAL_FILE}"

if [ -s "${PARTIAL_FILE}" ]; then
    mv "${PARTIAL_FILE}" "${BACKUP_FILE}"
    echo "[$(date)] Backup created: ${BACKUP_FILE}"
    echo "[$(date)] Size: $(du -h "${BACKUP_FILE}" | cut -f1)"
else
    echo "[$(date)] ERROR: Backup failed!"
    exit 1
fi

# GNU tar exits 1 when a file changed while it was read (the task worker keeps writing): the archive
# is complete, and that file is in its earlier or later state. Anything above 1 is a failure.
MEDIA_STATUS=0
tar -C "$(dirname "${MEDIA_ROOT}")" -czf "${MEDIA_PARTIAL}" "$(basename "${MEDIA_ROOT}")" || MEDIA_STATUS=$?
if [ "${MEDIA_STATUS}" -le 1 ]; then
    mv "${MEDIA_PARTIAL}" "${MEDIA_FILE}"
    if [ "${MEDIA_STATUS}" -eq 1 ]; then
        echo "[$(date)] WARNING: Media changed while it was archived"
    fi
    echo "[$(date)] Media archived: ${MEDIA_FILE} ($(du -h "${MEDIA_FILE}" | cut -f1))"
fi

# Cleanup old backups, and the media archives that go with them. Also after a media failure, so a
# lasting one does not pile dumps up.
echo "[$(date)] Cleaning up backups older than ${RETENTION_DAYS} days..."
find "${BACKUP_DIR}" -maxdepth 1 -type f -user "$(id -un)" -name "praho_backup_*.dump" -mtime "+${RETENTION_DAYS}" -delete
find "${BACKUP_DIR}" -maxdepth 1 -type f -user "$(id -un)" -name "praho_backup_*.media.tar.gz" -mtime "+${RETENTION_DAYS}" -delete

if [ "${MEDIA_STATUS}" -gt 1 ]; then
    # The database dump is complete and kept; the run still fails, so cron notices.
    echo "[$(date)] ERROR: Media archive failed; the database backup ${BACKUP_FILE} is complete"
    exit 1
fi

echo "[$(date)] Current backups:"
ls -lh "${BACKUP_DIR}"/praho_backup_*.dump 2>/dev/null || echo "No backups found"

OFFSITE_HANDLED=1
"{{ project_root }}/.venv-linux/bin/python" "{{ project_root }}/src/services/platform/manage.py" \
    upload_platform_backup --database "$BACKUP_FILE" --media "$MEDIA_FILE"
echo "[$(date)] Backup completed successfully"
