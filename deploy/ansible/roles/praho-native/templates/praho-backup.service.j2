# Generated by Ansible. Runs once; this is not a resident task worker.
[Unit]
Description=PRAHO database and media backup
After=postgresql.service

[Service]
Type=oneshot
User={{ project_user }}
Group={{ project_group }}
WorkingDirectory={{ project_root }}/src/services/platform
EnvironmentFile={{ project_root }}/.env
Environment=DJANGO_SETTINGS_MODULE={{ django_settings_module }}
ExecStart={{ project_root }}/scripts/backup.sh
TimeoutStartSec=3h
UMask=0077
Nice=10
MemoryMax=256M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths={{ backup_directory }} {{ project_root }}/logs /var/log/praho
