{% elif native_legacy_portal_origin | default(false) %}
# Preserve the old origin through DNS expiry. It cannot run customer writers.
{{ deployed_env.PORTAL_DOMAIN }} {
    {% if native_tls_certificate | default('') %}
    tls {{ native_tls_certificate }} {{ native_tls_key }}
    {% else %}
    tls {{ deployed_env.ACME_EMAIL | default('admin@example.com') }}
    {% endif %}
    import native_security
    header {
        Retry-After "600"
        Cache-Control "no-store"
    }
    respond "Scheduled maintenance" 503
}
{% endif %}
{% if native_platform | default(true) %}
{{ deployed_env.PLATFORM_DOMAIN }} {
    {% if native_tls_certificate | default('') %}
    tls {{ native_tls_certificate }} {{ native_tls_key }}
    {% else %}
    tls {{ deployed_env.ACME_EMAIL | default('admin@example.com') }}
    {% endif %}

    import native_security

    route {
        # Public handles cap request bodies at Django's DATA_UPLOAD_MAX_MEMORY_SIZE (10 MiB). None takes a
        # multipart upload; the tickets API's attachments arrive base64 inside a JSON body, which Django
        # caps at the same size. So the cap refuses nothing Django would take, and an oversized body stops
        # here instead of streaming into a worker.
        @platform_health path /api/users/health /api/users/health/*
        handle @platform_health {
            @health_denied not remote_ip {{ (deployed_env.PRAHO_MONITORING_CIDRS | default('')).split() | join(' ') }} 127.0.0.1/32 ::1/128
            respond @health_denied "Access denied" 403
            request_body {
                max_size 10MiB
            }
            reverse_proxy 127.0.0.1:{{ platform_port }}
        }
        @api path /api /api/*
        handle @api {
            route {
                @api_denied not remote_ip {{ (deployed_env.PRAHO_PORTAL_API_SOURCE_CIDRS | default('')).split() | join(' ') }} {{ platform_allowed_ips | default(['127.0.0.1/32', '::1/128'], true) | join(' ') }} 127.0.0.1/32 ::1/128
                respond @api_denied "Access denied" 403
                # This signed read-only endpoint is the deployment authentication probe.
                @probe path /api/localisation/
                handle @probe {
                    request_body {
                        max_size 10MiB
                    }
                    reverse_proxy 127.0.0.1:{{ platform_port }}
                }
                handle {
                    import native_platform_hold api
                    request_body {
                        max_size 10MiB
                    }
                    reverse_proxy 127.0.0.1:{{ platform_port }}
                }
            }
        }
        import native_platform_hold public

        handle /integrations/webhooks/* {
            request_body {
                max_size 10MiB
            }
            reverse_proxy localhost:{{ platform_port }}
        }

        # Email provider bounce feeds and the recipient unsubscribe page are public too.
        handle /notifications/webhooks/* {
            request_body {
                max_size 10MiB
            }
            reverse_proxy localhost:{{ platform_port }}
        }

        handle /notifications/unsubscribe/* {
            request_body {
                max_size 10MiB
            }
            reverse_proxy localhost:{{ platform_port }}
        }

        # An omitted or empty list keeps the loopback restriction.
        @staff remote_ip {{ platform_allowed_ips | default(['127.0.0.1/32', '::1/128'], true) | join(' ') }}
        handle @staff {
            # The largest staff reply Django can accept: tickets.max_attachments_per_reply (at most 5)
            # files of tickets.max_file_size_bytes (at most 10 MiB), plus 2 MiB of multipart headroom.
            # Caddy cannot read settings, so this sits at their upper bounds; Django enforces the values
            # in effect. Media has no route here: every stored file is read through a Django view that
            # checks who is asking and records it (ADR-0057).
            request_body {
                max_size 62MiB
            }

            handle_path /static/* {
                root * {{ deployed_env.STATIC_ROOT | default(project_root + '/static') }}
                file_server
                header Cache-Control "public, max-age=31536000, immutable"
            }

            handle {
                reverse_proxy localhost:{{ platform_port }} {
                    header_up X-Real-IP {remote_host}
                    header_up X-Forwarded-For {remote_host}
                    header_up X-Forwarded-Proto {scheme}
                }
            }
        }

        respond "Access denied" 403

    }

    log {
        format filter {
            wrap json
