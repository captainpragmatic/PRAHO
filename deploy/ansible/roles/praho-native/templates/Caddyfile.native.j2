# Bare IPv4 HTTP requests retain the native Portal redirect.
http://{{ ansible_default_ipv4.address | default('0.0.0.0') }} {
    redir https://{{ deployed_env.PORTAL_DOMAIN }}{uri} permanent
}

{% if native_portal | default(true) and deployed_env.PRAHO_ADDRESS_IPV4_DOMAIN | default('') %}
{% for address_domain in [deployed_env.PRAHO_ADDRESS_IPV4_DOMAIN, deployed_env.PRAHO_ADDRESS_IPV6_DOMAIN] %}
{{ address_domain }} {
    {% if native_tls_certificate | default('') %}
    tls {{ native_tls_certificate }} {{ native_tls_key }}
    {% else %}
    tls {{ deployed_env.ACME_EMAIL | default('admin@example.com') }}
    {% endif %}
    import native_security
    route {
        header {
            Content-Type "text/plain; charset=utf-8"
            Cache-Control "no-store"
            Access-Control-Allow-Origin "https://{{ deployed_env.PORTAL_DOMAIN }}"
            -Set-Cookie
        }
        @forwarded header Forwarded *
        @xff header X-Forwarded-For *
        @xreal header X-Real-IP *
        @proto header X-Forwarded-Proto *
        respond @forwarded "Forwarding headers are not accepted" 400
        respond @xff "Forwarding headers are not accepted" 400
        respond @xreal "Forwarding headers are not accepted" 400
        respond @proto "Forwarding headers are not accepted" 400
        @address {
            method GET
            path /
        }
        respond @address "{remote_host}" 200
        respond "Not found" 404
    }
}
{% endfor %}
{% endif %}
