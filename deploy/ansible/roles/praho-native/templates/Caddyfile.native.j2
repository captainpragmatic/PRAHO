{{ deployed_env.PLATFORM_DOMAIN }} {
    tls {{ deployed_env.ACME_EMAIL | default('admin@example.com') }}

    # HSTS_POLICY sets this per environment (staging: max-age=3600). It is set twice on purpose:
    # the deferred block below replaces the header Django sends, and this immediate line covers
    # responses Caddy generates itself (a 502 when the upstream is down), which skip deferred headers.
    header Strict-Transport-Security "{{ hsts_policy }}"
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "{{ hsts_policy }}"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    encode gzip zstd

    # Public handles cap request bodies at Django's DATA_UPLOAD_MAX_MEMORY_SIZE (10 MiB). None takes a
    # multipart upload; the tickets API's attachments arrive base64 inside a JSON body, which Django
    # caps at the same size. So the cap refuses nothing Django would take, and an oversized body stops
    # here instead of streaming into a worker.
    handle /api/users/health/* {
        request_body {
            max_size 10MiB
        }
        reverse_proxy localhost:{{ platform_port }}
    }

    handle /integrations/webhooks/* {
        request_body {
            max_size 10MiB
        }
        reverse_proxy localhost:{{ platform_port }}
    }

    # Email provider bounce feeds and the recipient unsubscribe page are public too.
    handle /notifications/webhooks/* {
        request_body {
            max_size 10MiB
        }
        reverse_proxy localhost:{{ platform_port }}
    }

    handle /notifications/unsubscribe/* {
        request_body {
            max_size 10MiB
        }
        reverse_proxy localhost:{{ platform_port }}
    }

    # Django enforces API authentication, including its explicit public exceptions.
    handle /api/* {
        request_body {
            max_size 10MiB
        }
        reverse_proxy localhost:{{ platform_port }}
    }

    # An omitted or empty list keeps the loopback restriction.
    @staff remote_ip {{ platform_allowed_ips | default(['127.0.0.1/32', '::1/128'], true) | join(' ') }}
    handle @staff {
        # The largest staff reply Django can accept: tickets.max_attachments_per_reply (at most 5)
        # files of tickets.max_file_size_bytes (at most 10 MiB), plus 2 MiB of multipart headroom.
        # Caddy cannot read settings, so this sits at their upper bounds; Django enforces the values
        # in effect. Media has no route here: every stored file is read through a Django view that
        # checks who is asking and records it (ADR-0057).
        request_body {
            max_size 62MiB
        }

        handle_path /static/* {
            root * {{ project_root }}/static
            file_server
            header Cache-Control "public, max-age=31536000, immutable"
        }

        handle {
            reverse_proxy localhost:{{ platform_port }} {
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-For {remote_host}
                header_up X-Forwarded-Proto {scheme}
            }
        }
    }

    respond "Access denied" 403

    log {
        format filter {
            wrap json
            fields {
                request>uri regexp "(?i)((?:/|%2f)(?:(?:a|%61)(?:u|%75)(?:t|%74)(?:h|%68)(?:/|%2f)(?:p|%70)(?:a|%61)(?:s|%73)(?:s|%73)(?:w|%77)(?:o|%6f)(?:r|%72)(?:d|%64)(?:-|%2d)(?:r|%72)(?:e|%65)(?:s|%73)(?:e|%65)(?:t|%74)(?:-|%2d)(?:c|%63)(?:o|%6f)(?:n|%6e)(?:f|%66)(?:i|%69)(?:r|%72)(?:m|%6d)|(?:p|%70)(?:a|%61)(?:s|%73)(?:s|%73)(?:w|%77)(?:o|%6f)(?:r|%72)(?:d|%64)(?:-|%2d)(?:r|%72)(?:e|%65)(?:s|%73)(?:e|%65)(?:t|%74)(?:/|%2f)(?:c|%63)(?:o|%6f)(?:n|%6e)(?:f|%66)(?:i|%69)(?:r|%72)(?:m|%6d)|(?:r|%72)(?:e|%65)(?:g|%67)(?:i|%69)(?:s|%73)(?:t|%74)(?:e|%65)(?:r|%72)(?:/|%2f)(?:c|%63)(?:o|%6f)(?:n|%6e)(?:f|%66)(?:i|%69)(?:r|%72)(?:m|%6d))(?:/|%2f)(?:[^/%?# ]|%(?:[^2]|2[^f]))+(?:/|%2f)|(?:/|%2f)(?:n|%6e)(?:o|%6f)(?:t|%74)(?:i|%69)(?:f|%66)(?:i|%69)(?:c|%63)(?:a|%61)(?:t|%74)(?:i|%69)(?:o|%6f)(?:n|%6e)(?:s|%73)(?:/|%2f)(?:u|%75)(?:n|%6e)(?:s|%73)(?:u|%75)(?:b|%62)(?:s|%73)(?:c|%63)(?:r|%72)(?:i|%69)(?:b|%62)(?:e|%65)(?:/|%2f))(?:[^/%?# ]|%(?:[^2]|2[^f]))+" "${1}[REDACTED]"
                request>headers>Referer regexp "(?i)((?:/|%2f)(?:(?:a|%61)(?:u|%75)(?:t|%74)(?:h|%68)(?:/|%2f)(?:p|%70)(?:a|%61)(?:s|%73)(?:s|%73)(?:w|%77)(?:o|%6f)(?:r|%72)(?:d|%64)(?:-|%2d)(?:r|%72)(?:e|%65)(?:s|%73)(?:e|%65)(?:t|%74)(?:-|%2d)(?:c|%63)(?:o|%6f)(?:n|%6e)(?:f|%66)(?:i|%69)(?:r|%72)(?:m|%6d)|(?:p|%70)(?:a|%61)(?:s|%73)(?:s|%73)(?:w|%77)(?:o|%6f)(?:r|%72)(?:d|%64)(?:-|%2d)(?:r|%72)(?:e|%65)(?:s|%73)(?:e|%65)(?:t|%74)(?:/|%2f)(?:c|%63)(?:o|%6f)(?:n|%6e)(?:f|%66)(?:i|%69)(?:r|%72)(?:m|%6d)|(?:r|%72)(?:e|%65)(?:g|%67)(?:i|%69)(?:s|%73)(?:t|%74)(?:e|%65)(?:r|%72)(?:/|%2f)(?:c|%63)(?:o|%6f)(?:n|%6e)(?:f|%66)(?:i|%69)(?:r|%72)(?:m|%6d))(?:/|%2f)(?:[^/%?# ]|%(?:[^2]|2[^f]))+(?:/|%2f)|(?:/|%2f)(?:n|%6e)(?:o|%6f)(?:t|%74)(?:i|%69)(?:f|%66)(?:i|%69)(?:c|%63)(?:a|%61)(?:t|%74)(?:i|%69)(?:o|%6f)(?:n|%6e)(?:s|%73)(?:/|%2f)(?:u|%75)(?:n|%6e)(?:s|%73)(?:u|%75)(?:b|%62)(?:s|%73)(?:c|%63)(?:r|%72)(?:i|%69)(?:b|%62)(?:e|%65)(?:/|%2f))(?:[^/%?# ]|%(?:[^2]|2[^f]))+" "${1}[REDACTED]"
            }
        }
        output file /var/log/caddy/platform-access.log {
