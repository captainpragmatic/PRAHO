(native_security) {
    # The immediate HSTS covers edge errors; deletion makes the block deferred over upstream headers.
    header Strict-Transport-Security "{{ hsts_policy }}"
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "{{ hsts_policy }}"
        -Server
    }
    encode gzip zstd
}

(native_platform_hold) {
    @platform_hold_{args[0]} file {
        root /etc/praho-native
        try_files hold-platform
    }
    handle @platform_hold_{args[0]} {
        header Retry-After "600"
        @json_{args[0]} path /api /api/*
        header @json_{args[0]} Content-Type application/json
        respond @json_{args[0]} `{"error":"maintenance","detail":"The platform is temporarily unavailable for scheduled maintenance.","retry_after":600}` 503
        respond "Scheduled maintenance" 503
    }
}

