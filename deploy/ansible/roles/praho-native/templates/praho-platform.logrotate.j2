# PRAHO Platform log rotation
# Generated by Ansible - DO NOT EDIT
#
# The gunicorn workers and the qcluster workers all write these files, so Platform never rotates
# them itself: its WatchedFileHandler reopens a file once logrotate has moved it, and re-creates it
# (as it always created it), so logrotate does not (nocreate). No UMask on these units: Django
# creates upload directories under the same mask, and Caddy must be able to serve them. Each policy keeps as many files
# as the in-process rotation did; logrotate runs hourly, so a file past its size is rotated within
# the hour. See services/platform/config/settings/log_files.py.
/var/log/praho/app.log {
    daily
    maxsize 50M
    rotate 10
    compress
    delaycompress
    missingok
    notifempty
    su {{ project_user }} {{ project_group }}
    nocreate
}

/var/log/praho/error.log
/var/log/praho/security.log {
    daily
    maxsize 50M
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    su {{ project_user }} {{ project_group }}
    nocreate
}

# The audit trail's file copy: 90 kept, as before (the authoritative trail is in the database).
/var/log/praho/audit.log {
    daily
    maxsize 100M
    rotate 90
    compress
    delaycompress
    missingok
    notifempty
    su {{ project_user }} {{ project_group }}
    nocreate
}
