# PRAHO Portal Service (Native)
# Generated by Ansible - DO NOT EDIT

[Unit]
Description=PRAHO Portal (Django customer-facing service)
After=praho-platform.service network.target
Wants=praho-platform.service

[Service]
Type=notify
# Files the portal creates (its log files, re-created after rotation) are not world-readable.
UMask=0027
User={{ project_user }}
Group={{ project_group }}
WorkingDirectory={{ project_root }}/src/services/portal
EnvironmentFile={{ project_root }}/.env
Environment="SESSION_DB_PATH={{ portal_django_env.SESSION_DB_PATH }}"
Environment="PORTAL_TRUSTED_PROXY_CIDRS={{ portal_django_env.PORTAL_TRUSTED_PROXY_CIDRS }}"
# Read by services/portal/gunicorn.conf.py; the .env above (EnvironmentFile) overrides these.
Environment="PORTAL_GUNICORN_WORKER_CLASS={{ gunicorn_worker_class_portal }}"
Environment="PORTAL_GUNICORN_WORKERS={{ gunicorn_workers_portal }}"
Environment="PORTAL_GUNICORN_THREADS={{ gunicorn_threads_portal }}"
# Refuse bad PORTAL_GUNICORN_* values before any migration runs (services/portal/config/server_settings.py).
ExecStartPre={{ project_root }}/.venv-linux/bin/python -m config.server_settings
ExecStartPre={{ project_root }}/.venv-linux/bin/python manage.py migrate sessions --noinput
ExecStartPre={{ project_root }}/.venv-linux/bin/python manage.py migrate common --noinput
ExecStartPre={{ project_root }}/.venv-linux/bin/python manage.py check --deploy --fail-level ERROR
ExecStart={{ project_root }}/.venv-linux/bin/gunicorn \
    --bind 127.0.0.1:{{ portal_port }} \
    --no-control-socket \
    config.wsgi:application
Restart=on-failure
RestartSec=5

# Resource limits
MemoryMax={{ portal_memory_max }}

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths={{ project_root }}/logs /var/log/praho/portal {{ project_root }}/src/services/portal "{{ portal_django_env.SESSION_DB_PATH | dirname }}"

[Install]
WantedBy=multi-user.target
