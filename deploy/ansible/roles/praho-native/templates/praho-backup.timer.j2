# Generated by Ansible. The operator's timezone also governs application schedules.
[Unit]
Description=Schedule PRAHO database and media backups

[Timer]
OnCalendar=*-*-* 02:00:00 {{ deployed_env.TIME_ZONE | default('Europe/Bucharest') }}
Persistent=true
Unit=praho-backup.service

[Install]
WantedBy=timers.target
