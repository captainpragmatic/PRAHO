# PRAHO Portal log rotation
# Generated by Ansible - DO NOT EDIT
#
# Several portal processes write these files, so the portal never rotates them itself: its
# WatchedFileHandler reopens a file once logrotate has moved it (config/settings/logging_config.py).
/var/log/praho/portal/*.log {
    daily
    maxsize 50M
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    su {{ project_user }} {{ project_group }}
    create 0640 {{ project_user }} {{ project_group }}
}
