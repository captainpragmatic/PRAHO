#!/bin/bash
# Native recovery: validate and preserve inputs before backup, downtime or database mutation.
set -euo pipefail
umask 077
export PGPASSFILE="{{ project_root }}/credentials/postgresql.pgpass"
BACKUP_DIR="{{ backup_directory }}"
DB_NAME={{ deployed_env.DB_NAME | default('praho') | quote }}
DB_USER={{ deployed_env.DB_USER | default('praho') | quote }}
DB_HOST={{ deployed_env.DB_HOST | default('localhost') | quote }}
DB_PORT={{ deployed_env.DB_PORT | default('5432') | quote }}
MEDIA_ROOT={{ deployed_env.MEDIA_ROOT | default(project_root + '/media') | quote }}
MEDIA_NAME=$(basename "$MEDIA_ROOT")
SERVICES=(praho-platform {% if native_topology | default('combined') != 'split' %}praho-portal {% endif %}praho-qcluster)
STOP_SERVICES=(praho-qcluster {% if native_topology | default('combined') != 'split' %}praho-portal {% endif %}praho-platform)
LEAVE_STOPPED=false
if [ "${1:-}" = --leave-stopped ]; then LEAVE_STOPPED=true; shift; fi
{% if native_topology | default('combined') == 'split' %}
if ! $LEAVE_STOPPED; then
    echo 'ERROR: Split native recovery requires --leave-stopped with both origins held; resume through the coordinated launcher.' >&2
    exit 1
fi
{% endif %}
if $LEAVE_STOPPED; then
    if [ ! -f /etc/praho-native/hold-platform ] || [ ! -f /etc/praho-native/hold-workers ] ||
       systemctl is-active --quiet praho-qcluster; then
        echo 'ERROR: Establish both ingress holds and drain workers before held recovery.' >&2; exit 1
    fi
elif [ -f /etc/praho-native/hold-workers ] || [ -f /etc/praho-native/hold-platform ]; then
    echo 'ERROR: Native maintenance is active; use --leave-stopped and resume through the coordinated launcher.' >&2; exit 1
fi
case "$DB_HOST:$DB_PORT" in localhost:5432|127.0.0.1:5432) ;;
    *) echo 'ERROR: Native recovery supports the local bundled PostgreSQL on port 5432 only' >&2; exit 1 ;;
esac
if [ $# -ne 1 ]; then echo "Usage: $0 [--leave-stopped] [--latest | backup.dump]" >&2; exit 1; fi
if [ "$1" = --latest ]; then
    BACKUP_FILE=$(ls -t "$BACKUP_DIR"/praho_backup_*.dump 2>/dev/null | head -1) || true
else
    BACKUP_FILE="$1"
    if [ ! -f "$BACKUP_FILE" ]; then BACKUP_FILE="$BACKUP_DIR/$1"; fi
fi
if [ ! -s "${BACKUP_FILE:-}" ]; then echo 'ERROR: Nonempty backup file required' >&2; exit 1; fi
STAGE=$(mktemp -d "${TMPDIR:-/tmp}/praho-native-restore.XXXXXX")
WRITERS_STOPPED=false
COMPLETE=false
finish() {
    local result=$?
    rm -rf -- "$STAGE"
    if $WRITERS_STOPPED && ! $COMPLETE; then
        echo 'ERROR: Recovery failed; applications remain stopped. Inspect the database and use the pre-restore safety backup before restarting services.' >&2
    fi
    return "$result"
}
trap finish EXIT
cp -- "$BACKUP_FILE" "$STAGE/database.dump"
# Listing alone reads only the TOC. Rendering all SQL also decompresses every data block without
# connecting to a database. Neither proves schema/version compatibility with the target application.
if ! pg_restore --list "$STAGE/database.dump" > "$STAGE/toc" ||
   ! grep -Eq '^[0-9]+; .* TABLE DATA ' "$STAGE/toc" ||
   ! pg_restore --file=/dev/null "$STAGE/database.dump"; then
    echo 'ERROR: Invalid, incomplete or empty custom dump; nothing was restored' >&2; exit 1
fi
MEDIA_FILE="${BACKUP_FILE%.dump}.media.tar.gz"
HAS_MEDIA=false
if [ -f "$MEDIA_FILE" ]; then
    cp -- "$MEDIA_FILE" "$STAGE/media.tar.gz"
    if ! gzip -t "$STAGE/media.tar.gz" || ! tar -tzf "$STAGE/media.tar.gz" > "$STAGE/members" ||
       ! grep -Fxq -e "$MEDIA_NAME" -e "$MEDIA_NAME/" "$STAGE/members" ||
       ! awk -v root="$MEDIA_NAME" -F/ '{if ($1 != root) exit 1; for(i=1;i<=NF;i++) if($i == "..") exit 1}' "$STAGE/members"; then
        echo 'ERROR: Invalid media archive; nothing was restored' >&2; exit 1
    fi
    HAS_MEDIA=true
else
    echo 'WARNING: No media archive for this backup; media will be left as it is'
fi
read -r -p 'This overwrites the current database. Continue? (yes/no): ' CONFIRM
if [ "$CONFIRM" != yes ]; then echo 'Restore cancelled'; exit 0; fi
# The held mode explicitly runs the backup as its owner without opening the
# scheduled worker gate. Credentials are loaded on the target, never into argv.
if $LEAVE_STOPPED; then
    if ! SAFETY_OUTPUT=$(runuser -u {{ project_user | quote }} -- /usr/local/lib/praho/native_exec.sh "{{ project_root }}/.env" -- "{{ project_root }}/scripts/backup.sh"); then
        echo 'ERROR: Pre-restore safety backup failed; nothing was restored.' >&2; exit 1
    fi
else
# The service supplies the backup owner and its complete deployed environment.
journalctl --sync
SAFETY_CURSOR=$(journalctl -n 0 --show-cursor --no-pager --output=cat | sed -n 's/^-- cursor: //p')
if [ -z "$SAFETY_CURSOR" ] || [[ "$SAFETY_CURSOR" == *$'\n'* ]]; then
    echo 'ERROR: Cannot capture safety backup journal cursor; nothing was restored' >&2; exit 1
fi
if ! systemctl start --wait praho-backup.service; then
    echo 'ERROR: Pre-restore safety backup failed; nothing was restored. Verify praho-backup.service is deployed.' >&2; exit 1
fi
# Inactive oneshot units can be collected immediately, losing InvocationID. A
# journal cursor works with the backup timer disabled and excludes old successes.
journalctl --sync
SAFETY_OUTPUT=$(journalctl -u praho-backup.service "--after-cursor=$SAFETY_CURSOR" --no-pager --output=cat)
fi
SAFETY_DUMP=$(sed -n 's/^.* Backup created: //p' <<< "$SAFETY_OUTPUT")
# Lock contention exits zero without creating a pair. Require evidence from this
# fresh log window before stopping writers or replacing their database.
case "$SAFETY_DUMP" in
    "$BACKUP_DIR"/praho_backup_*.dump) ;;
    *) echo 'ERROR: No completed safety backup pair; nothing was restored' >&2; exit 1 ;;
esac
if ! grep -Fq 'Backup completed successfully' <<< "$SAFETY_OUTPUT" ||
   [ ! -s "$SAFETY_DUMP" ] || [ -L "$SAFETY_DUMP" ] ||
   [ ! -s "${SAFETY_DUMP%.dump}.media.tar.gz" ] || [ -L "${SAFETY_DUMP%.dump}.media.tar.gz" ]; then
    echo 'ERROR: Cannot verify completed safety backup pair; nothing was restored' >&2; exit 1
fi
# A failed stop can leave only some services stopped. Never mutate the database in that case.
if ! systemctl stop "${STOP_SERVICES[@]}"; then
    echo 'ERROR: Could not stop all writers; database unchanged. Some services may already be stopped.' >&2; exit 1
fi
WRITERS_STOPPED=true
sudo -u postgres dropdb --if-exists "$DB_NAME"
sudo -u postgres createdb --template=template0 --encoding=UTF8 --lc-collate=en_US.UTF-8 --lc-ctype=en_US.UTF-8 -O "$DB_USER" "$DB_NAME"
pg_restore -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d "$DB_NAME" \
    --exit-on-error --no-owner --no-privileges "$STAGE/database.dump"
if $HAS_MEDIA; then
    sudo -u {{ project_user | quote }} tar --no-same-owner --no-same-permissions -C "$(dirname "$MEDIA_ROOT")" -xzf - < "$STAGE/media.tar.gz"
fi
# After a restore, files written since the backup have no row, and the orphaned-media sweep would
# delete them a day later: pause it for seven days. A backup taken before the sweeper existed has no
# row, so the statement inserts one. The same statement runs in both restore scripts
# (tests/common/test_media_sweep_restore_pause.py runs it against the schema).
PAUSE_MEDIA_SWEEP_SQL="INSERT INTO setting_entries (key, category, name, description, help_text, data_type, value, default_value, is_required, is_sensitive, is_active, requires_restart, created_at, updated_at, revision) VALUES ('media_sweep.paused_until', 'platform', 'Orphaned file cleanup paused until', 'Set by a database restore', '', 'string', to_jsonb(now() + interval '7 days'), to_jsonb(''::text), false, false, true, false, now(), now(), 1) ON CONFLICT (key) DO UPDATE SET value = EXCLUDED.value, updated_at = now(), revision = setting_entries.revision + 1 RETURNING value #>> '{}'"
PAUSED_UNTIL=$(psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d "$DB_NAME" --set=ON_ERROR_STOP=1 -tAq -c "$PAUSE_MEDIA_SWEEP_SQL")
if [ -z "$PAUSED_UNTIL" ]; then
    echo 'ERROR: The orphaned-media sweep pause returned no value; applications remain stopped.' >&2
    exit 1
fi
echo "Orphaned-media sweep paused until $PAUSED_UNTIL"
if $LEAVE_STOPPED; then
    COMPLETE=true
    echo 'Restore completed successfully; coordinated maintenance remains active. Resume through the native launcher.'
    exit 0
fi
hold_offline() {
    systemctl stop "${STOP_SERVICES[@]}" ||
        echo 'ERROR: Could not hold every application offline; operator intervention required' >&2
}
if ! systemctl start "${SERVICES[@]}"; then hold_offline; exit 1; fi
ATTEMPTS="${RESTORE_HEALTH_ATTEMPTS:-60}"
if [[ ! "$ATTEMPTS" =~ ^[1-9][0-9]*$ ]]; then hold_offline; exit 1; fi
for ((attempt=1; attempt<=ATTEMPTS; attempt++)); do
    if systemctl is-active --quiet "${SERVICES[@]}" &&
       curl --max-time 5 -fsS "http://localhost:{{ platform_port }}/api/users/health/" > /dev/null; then
        PORTAL_STATUS=$(curl --max-time 5 -sS -o /dev/null -w '%{http_code}' "http://localhost:{{ portal_port }}/billing/") || PORTAL_STATUS=000
        if [ "$PORTAL_STATUS" = 200 ] || [ "$PORTAL_STATUS" = 302 ]; then
            COMPLETE=true
            echo 'Restore completed successfully; web routes respond and task-worker service is active'
            exit 0
        fi
    fi
    sleep 2
done
hold_offline
exit 1
