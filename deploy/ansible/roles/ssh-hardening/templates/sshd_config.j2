# Managed by PRAHO's ssh-hardening role. Custom access policy requires review.
{% for port in ssh_phase_ports | unique %}
Port {{ port }}
{% endfor %}
PermitRootLogin prohibit-password
PubkeyAuthentication yes
AuthenticationMethods publickey
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
HostbasedAuthentication no
UsePAM yes
StrictModes yes
AuthorizedKeysFile {{ ssh_authorized_keys_files | join(' ') }}
MaxAuthTries 6
LoginGraceTime 30
UseDNS no
X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding no
AllowStreamLocalForwarding no
PermitTunnel no
PermitUserEnvironment no
ClientAliveInterval 300
ClientAliveCountMax 2
PrintMotd no
AcceptEnv LANG LC_*
# External SFTP honors disabled account login shells during Virtualmin migration barriers.
Subsystem sftp /usr/lib/openssh/sftp-server
{% if ssh_webmin_tunnel_enabled | default(false) %}
# BEGIN PRAHO WEBMIN TUNNEL
Match User praho-webmin-tunnel
    AllowTcpForwarding local
    PermitOpen 127.0.0.1:10000
    PermitTTY no
    ForceCommand /bin/false
    GatewayPorts no
Match all
# END PRAHO WEBMIN TUNNEL
{% endif %}
