# =============================================================================
# PRAHO - Caddy Reverse Proxy Configuration
# =============================================================================
# Two distinct hostnames are required because the services share URL paths.

{
    servers {
        timeouts {
            # A request body must arrive within this, so a client trickling an upload cannot hold
            # Caddy's request buffer (or, before it, an application thread) for as long as it likes.
            # It applies to every site on this server, Platform included: 120 s matches Platform's
            # own request timeout. A body cut off here reaches the application short, which refuses
            # it (apps/common/complete_body.py) rather than saving a partial request.
            read_body 120s
        }
    }
}

{$PORTAL_DOMAIN} {
    tls {$ACME_EMAIL:admin@example.com}

    # HSTS_POLICY sets this per environment (staging: max-age=3600). It is set twice on purpose:
    # the deferred block below replaces the header Django sends, and this immediate line covers
    # responses Caddy generates itself (a 502 when the upstream is down), which skip deferred headers.
    header Strict-Transport-Security "{$HSTS_POLICY:max-age=31536000; includeSubDomains}"
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "{$HSTS_POLICY:max-age=31536000; includeSubDomains}"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    encode gzip zstd

    handle_path /static/* {
        root * /srv/portal-static
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    handle /status/ {
        reverse_proxy portal:8701
    }

    handle {
        # Leave multipart headroom above the 1 MiB ticket attachment limit.
        request_body {
            max_size 5MB
        }
        reverse_proxy portal:8701 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            # Read the whole request before passing it on (the buffer is above the 5MB cap, so any
            # accepted body is complete), and up to 10MiB of the response before sending it: a slow
            # client then holds Caddy, not a portal thread.
            request_buffers 6MB
            response_buffers 10MiB
        }
    }

    log {
        output file /data/portal-access.log {
            roll_size 100mb
            roll_keep 5
        }
    }
}

{$PLATFORM_DOMAIN} {
    tls {$ACME_EMAIL:admin@example.com}

    # HSTS_POLICY sets this per environment (staging: max-age=3600). It is set twice on purpose:
    # the deferred block below replaces the header Django sends, and this immediate line covers
    # responses Caddy generates itself (a 502 when the upstream is down), which skip deferred headers.
    header Strict-Transport-Security "{$HSTS_POLICY:max-age=31536000; includeSubDomains}"
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "{$HSTS_POLICY:max-age=31536000; includeSubDomains}"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    encode gzip zstd

    # Public handles cap request bodies at Django's DATA_UPLOAD_MAX_MEMORY_SIZE (10 MiB).
    # None of these routes accepts file uploads, so the cap refuses nothing Django would
    # take, and an oversized body stops here instead of streaming into a worker.
    handle /api/users/health/* {
        request_body {
            max_size 10MiB
        }
        reverse_proxy platform:8700
    }

    handle /integrations/webhooks/* {
        request_body {
            max_size 10MiB
        }
        reverse_proxy platform:8700
    }

    # Email provider bounce feeds and the recipient unsubscribe page are public too.
    handle /notifications/webhooks/* {
        request_body {
            max_size 10MiB
        }
        reverse_proxy platform:8700
    }

    handle /notifications/unsubscribe/* {
        request_body {
            max_size 10MiB
        }
        reverse_proxy platform:8700
    }

    # Django enforces API authentication, including its explicit public exceptions.
    handle /api/* {
        request_body {
            max_size 10MiB
        }
        reverse_proxy platform:8700
    }

    # Space-separated CIDRs; Caddy is the edge and matches the immediate peer.
    @staff remote_ip {$PLATFORM_ALLOWED_CIDRS:127.0.0.1/32 ::1/128}
    handle @staff {
        handle_path /static/* {
            root * /srv/static
            file_server
            header Cache-Control "public, max-age=31536000, immutable"
        }

        handle_path /media/* {
            root * /srv/media
            file_server
            header Cache-Control "public, max-age=86400"
        }

        handle {
            reverse_proxy platform:8700 {
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-For {remote_host}
                header_up X-Forwarded-Proto {scheme}
            }
        }
    }

    respond "Access denied" 403

    log {
        output file /data/platform-access.log {
            roll_size 100mb
            roll_keep 5
        }
    }
}
