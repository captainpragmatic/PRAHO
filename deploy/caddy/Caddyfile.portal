# =============================================================================
# PRAHO - Caddy Configuration for Portal-Only Deployment
# =============================================================================

{$PORTAL_DOMAIN} {
    tls {$ACME_EMAIL:admin@example.com}

    # HSTS_POLICY sets this per environment (staging: max-age=3600). It is set twice on purpose:
    # the deferred block below replaces the header Django sends, and this immediate line covers
    # responses Caddy generates itself (a 502 when the upstream is down), which skip deferred headers.
    header Strict-Transport-Security "{$HSTS_POLICY:max-age=31536000; includeSubDomains}"
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "{$HSTS_POLICY:max-age=31536000; includeSubDomains}"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    encode gzip zstd

    handle_path /static/* {
        root * /srv/static
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    handle /status/ {
        reverse_proxy portal:8701
    }

    handle {
        # Cap request bodies at the edge. The application already limits
        # ticket attachments to 1 MiB aggregate; 5MB leaves multipart headroom
        # while stopping oversized uploads before they reach the Portal.
        request_body {
            max_size 5MB
        }
        reverse_proxy portal:8701 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            # Read the whole request (at most the 5MB cap) before passing it on, and up to 10MiB of
            # the response before sending it: a slow client then holds Caddy, not a portal thread.
            request_buffers 5MB
            response_buffers 10MiB
        }
    }

    log {
        output file /data/access.log {
            roll_size 100mb
            roll_keep 5
        }
    }
}
