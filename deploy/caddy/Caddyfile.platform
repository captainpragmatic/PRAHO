# =============================================================================
# PRAHO - Caddy Configuration for Platform-Only Deployment
# =============================================================================

{
    servers {
        timeouts {
            # A request body must arrive within this, so a client trickling an upload cannot hold
            # Caddy's request buffer (or, before it, an application thread) for as long as it likes.
            # 120 s matches Platform's own request timeout. A body cut off here reaches the
            # application short, which refuses it (apps/common/complete_body.py) rather than saving
            # a partial request.
            read_body 120s
        }
    }
}

{$PLATFORM_DOMAIN} {
    tls {$ACME_EMAIL:admin@example.com}

    # HSTS_POLICY sets this per environment (staging: max-age=3600). It is set twice on purpose:
    # the deferred block below replaces the header Django sends, and this immediate line covers
    # responses Caddy generates itself (a 502 when the upstream is down), which skip deferred headers.
    header Strict-Transport-Security "{$HSTS_POLICY:max-age=31536000; includeSubDomains}"
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "{$HSTS_POLICY:max-age=31536000; includeSubDomains}"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    encode gzip zstd

    # Public handles cap request bodies at Django's DATA_UPLOAD_MAX_MEMORY_SIZE (10 MiB).
    # None of these routes accepts file uploads, so the cap refuses nothing Django would
    # take, and an oversized body stops here instead of streaming into a worker.
    handle /api/users/health/* {
        request_body {
            max_size 10MiB
        }
        reverse_proxy platform:8700
    }

    handle /integrations/webhooks/* {
        request_body {
            max_size 10MiB
        }
        reverse_proxy platform:8700
    }

    # Email provider bounce feeds and the recipient unsubscribe page are public too.
    handle /notifications/webhooks/* {
        request_body {
            max_size 10MiB
        }
        reverse_proxy platform:8700
    }

    handle /notifications/unsubscribe/* {
        request_body {
            max_size 10MiB
        }
        reverse_proxy platform:8700
    }

    # Django enforces API authentication, including its explicit public exceptions.
    handle /api/* {
        request_body {
            max_size 10MiB
        }
        reverse_proxy platform:8700
    }

    # Space-separated CIDRs; Caddy is the edge and matches the immediate peer.
    @staff remote_ip {$PLATFORM_ALLOWED_CIDRS:127.0.0.1/32 ::1/128}
    handle @staff {
        # The largest staff reply Django can accept: tickets.max_attachments_per_reply (at most 5)
        # files of tickets.max_file_size_bytes (at most 10 MiB), plus 2 MiB of multipart headroom.
        # Caddy cannot read settings, so this sits at their upper bounds; Django enforces the values
        # in effect. Media has no route here: every stored file is read through a Django view that
        # checks who is asking and records it (ADR-0057).
        request_body {
            max_size 52MiB
        }

        handle_path /static/* {
            root * /srv/static
            file_server
            header Cache-Control "public, max-age=31536000, immutable"
        }

        handle {
            reverse_proxy platform:8700 {
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-For {remote_host}
                header_up X-Forwarded-Proto {scheme}
            }
        }
    }

    respond "Access denied" 403

    log {
        output file /data/access.log {
            roll_size 100mb
            roll_keep 5
        }
    }
}
