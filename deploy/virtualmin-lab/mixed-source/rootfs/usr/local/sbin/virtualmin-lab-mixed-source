#!/bin/bash
# Only the opt-in mixed-source image enables these native services.
set -euo pipefail

test -f /var/lib/virtualmin-lab/configured
if [ ! -s /etc/usermin/miniserv.pem ]; then
  install -o root -g root -m 0600 /etc/webmin/miniserv.pem /etc/usermin/miniserv.pem
fi
virtualmin-config-system --bundle LAMP --exclude Nftables Firewalld Fail2ban Fail2banFirewalld \
  --log /var/log/virtualmin-lab-mixed-source.log
virtualmin set-global-feature --disable-feature spam --disable-feature virus \
  --default-off spam --default-off virus
virtualmin set-global-feature --enable-feature mail --enable-feature dns \
  --default-on mail --default-on dns
systemctl enable --now named.service postfix.service dovecot.service usermin.service
date -u +%Y-%m-%dT%H:%M:%SZ > /var/lib/virtualmin-lab/mixed-configured
