#!/bin/bash
# Apply credentials injected through the read-only volume mounted at
# /etc/lab-node/inject. Runs at every boot and can be re-run with docker exec
# after the files change. Absent files leave the node untouched.
#   root_password    separate local rescue password
#   authorized_keys  installed as /root/.ssh/authorized_keys
set -euo pipefail

inject_dir="${LAB_NODE_INJECT_DIR:-/etc/lab-node/inject}"

if [ -s "${inject_dir}/root_password" ]; then
  password="$(head -n 1 "${inject_dir}/root_password")"
  printf 'root:%s\n' "${password}" | chpasswd
  echo "root password applied"
fi

# Bootstrap renders the same SSH template as production. No transport proof is
# replaced: the lab still checks effective sshd policy and the actual listener.
if [ -s "${inject_dir}/sshd_config" ]; then
  test -s "${inject_dir}/operator_authorized_keys"
  if ! id -u praho-webmin-tunnel >/dev/null 2>&1; then
    useradd --system --user-group --create-home --shell /usr/sbin/nologin praho-webmin-tunnel
  fi
  tunnel_home="$(getent passwd praho-webmin-tunnel | cut -d: -f6)"
  install -d -m 0700 -o praho-webmin-tunnel -g praho-webmin-tunnel "${tunnel_home}/.ssh"
  tunnel_keys="${tunnel_home}/.ssh/authorized_keys.tmp"
  umask 077
  while IFS= read -r public_key; do
    [ -n "${public_key}" ] || continue
    printf 'restrict,port-forwarding,permitopen="127.0.0.1:10000" %s\n' "${public_key}"
  done < "${inject_dir}/operator_authorized_keys" > "${tunnel_keys}"
  chown praho-webmin-tunnel:praho-webmin-tunnel "${tunnel_keys}"
  mv -f "${tunnel_keys}" "${tunnel_home}/.ssh/authorized_keys"
  install -m 0600 -o root -g root "${inject_dir}/sshd_config" /etc/ssh/sshd_config.praho-lab
  /usr/sbin/sshd -t -f /etc/ssh/sshd_config.praho-lab
  mv -f /etc/ssh/sshd_config.praho-lab /etc/ssh/sshd_config
  if systemctl is-active --quiet ssh.service; then
    systemctl reload ssh.service
  fi
  echo "canonical SSH policy and restricted operator identity applied"
fi

if [ -s "${inject_dir}/authorized_keys" ]; then
  install -d -m 0700 -o root -g root /root/.ssh
  install -m 0600 -o root -g root "${inject_dir}/authorized_keys" /root/.ssh/authorized_keys.tmp
  mv -f /root/.ssh/authorized_keys.tmp /root/.ssh/authorized_keys
  echo "authorized_keys applied"
fi

# Match production enrollment: API access uses a durable dedicated principal.
# The canonical helper is injected by bootstrap, so this script never maintains
# a second copy of Webmin's account manipulation logic.
if [ -s "${inject_dir}/api_password" ]; then
  test -s "${inject_dir}/api_user_helper"
  test -s "${inject_dir}/api_cidrs"
  mapfile -t api_cidrs < "${inject_dir}/api_cidrs"
  perl "${inject_dir}/api_user_helper" praho-api "${api_cidrs[@]}" < "${inject_dir}/api_password"
  echo "dedicated API identity applied"
fi
