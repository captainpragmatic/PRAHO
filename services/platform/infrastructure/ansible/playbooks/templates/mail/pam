# Mail-only account throttling. Enrollment adds an explicit exact-user PAM passdb.
auth required pam_faillock.so preauth silent deny=@FAILURES@ fail_interval=@WINDOW@ unlock_time=@UNLOCK@ dir=/var/lib/praho/mail/faillock
auth [success=1 default=bad] pam_unix.so
auth [default=die] pam_faillock.so authfail deny=@FAILURES@ fail_interval=@WINDOW@ unlock_time=@UNLOCK@ dir=/var/lib/praho/mail/faillock
auth sufficient pam_faillock.so authsucc deny=@FAILURES@ fail_interval=@WINDOW@ unlock_time=@UNLOCK@ dir=/var/lib/praho/mail/faillock
auth required pam_deny.so
account required pam_unix.so
